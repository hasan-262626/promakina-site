# Bu dosya yalnız değişken ADLARINI içerir. Gerçek değerler Vercel → Environment Variables'a girilir;
# hiçbir gerçek secret bu dosyaya veya Git'e yazılmaz.

# --- Analitik (tarayıcıya açık kamusal kimlikler; secret değildir) ---
# Boşsa koddaki varsayılan GTM kimliği kullanılır.
NEXT_PUBLIC_GTM_ID=
# Opsiyonel: doğrudan GA4 (boşsa gtag yüklenmez)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Yalnız sunucu (asla NEXT_PUBLIC_ öneki almaz) ---
# İletişim ve teklif formu e-postaları (Resend)
RESEND_API_KEY=

# Admin paneli veritabanı: postgres://... (Neon / Vercel Postgres)
# Yalnız yerel geliştirme için gömülü veritabanı: pglite:.data/admin-db
DATABASE_URL=
# En az 32 karakter rastgele değer (ör. `openssl rand -base64 48`). IP/e-posta özetlerinde kullanılır.
AUTH_SECRET=
# `npm run admin:create` ilk kullanıcı e-postası (opsiyonel; boşsa terminalden sorulur). Parola asla env'e yazılmaz.
ADMIN_BOOTSTRAP_EMAIL=
# Site sağlığı taramasının kökeni. Boşsa https://www.promakina.com.tr. Yerel test: http://localhost:3100
ADMIN_SITE_ORIGIN=

# Panelden görsel yükleme (Vercel Blob, yalnız sunucu). Vercel'de tanımlı değilse yükleme kapalıdır; yerel geliştirmede .data/uploads kullanılır.
BLOB_READ_WRITE_TOKEN=
# 2FA zorunluluğu: SUPER_ADMIN (varsayılan) | ADMIN (Yönetici + Süper Yönetici) | ALL | NONE
ADMIN_REQUIRE_2FA=
